DEFINE TABLE IF NOT EXISTS producto SCHEMAFULL CHANGEFEED 3d;
DEFINE FIELD IF NOT EXISTS sku            ON producto TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD IF NOT EXISTS nombre         ON producto TYPE string ASSERT string::len($value) > 0;
DEFINE FIELD IF NOT EXISTS tipo           ON producto TYPE string;
DEFINE FIELD IF NOT EXISTS descripcion    ON producto TYPE option<string>;
DEFINE FIELD IF NOT EXISTS marca          ON producto TYPE option<record<marca>>;
DEFINE FIELD IF NOT EXISTS categoria      ON producto TYPE record<categoria>;
DEFINE FIELD IF NOT EXISTS atributos          ON producto TYPE array<object> DEFAULT [];
DEFINE FIELD IF NOT EXISTS atributos[*].def   ON producto TYPE record<atributo_def>;
DEFINE FIELD IF NOT EXISTS atributos[*].valor ON producto TYPE string | number | bool;
DEFINE FIELD IF NOT EXISTS codigos          ON producto TYPE array<object> DEFAULT [];
DEFINE FIELD IF NOT EXISTS codigos[*].tipo  ON producto TYPE string ASSERT $value IN ['fabricante', 'oem', 'barras'];
DEFINE FIELD IF NOT EXISTS codigos[*].valor ON producto TYPE string;
DEFINE FIELD IF NOT EXISTS unidad_medida  ON producto TYPE string DEFAULT 'unidad' ASSERT $value IN ['unidad', 'par', 'caja', 'metro', 'kilogramo', 'litro'];
DEFINE FIELD IF NOT EXISTS precio         ON producto TYPE decimal ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS ubicacion          ON producto TYPE option<object>;
DEFINE FIELD IF NOT EXISTS ubicacion.pasillo  ON producto TYPE option<string>;
DEFINE FIELD IF NOT EXISTS ubicacion.estante  ON producto TYPE option<string>;
DEFINE FIELD IF NOT EXISTS ubicacion.posicion ON producto TYPE option<string>;
DEFINE FIELD IF NOT EXISTS stock          ON producto TYPE decimal DEFAULT 0 ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS activo         ON producto TYPE bool DEFAULT true;
DEFINE FIELD IF NOT EXISTS version        ON producto TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS creado_en      ON producto TYPE datetime DEFAULT time::now() READONLY;
DEFINE FIELD IF NOT EXISTS actualizado_en ON producto TYPE datetime VALUE time::now();
DEFINE INDEX IF NOT EXISTS uq_producto_sku        ON producto FIELDS sku UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_producto_categoria ON producto FIELDS categoria;
DEFINE INDEX IF NOT EXISTS idx_producto_marca     ON producto FIELDS marca;
DEFINE ANALYZER IF NOT EXISTS an_respaldo TOKENIZERS blank, class FILTERS lowercase, ascii, edgengram(2, 15);
DEFINE INDEX IF NOT EXISTS ft_producto_nombre ON producto FIELDS nombre SEARCH ANALYZER an_respaldo BM25;
DEFINE INDEX IF NOT EXISTS idx_producto_codigos ON producto FIELDS codigos[*].valor;